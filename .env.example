# Copiá este archivo como .env y completá los valores. El .env no se sube a GitHub.

# Token del bot de Telegram que te da @BotFather (formato 123456789:ABC...).
TELEGRAM_BOT_TOKEN=

# Número de tu chat con el bot (se puede obtener después de mandarle un mensaje).
TELEGRAM_CHAT_ID=

# Canal publico donde el bot publica los avisos importantes (por ejemplo @bahiaalerta).
# El bot tiene que ser administrador del canal con permiso para publicar.
TELEGRAM_CANAL=

# Cada cuantos puntos de subida de un canal te avisa a vos (por defecto 5).
TELEGRAM_AVISO_CADA=5
